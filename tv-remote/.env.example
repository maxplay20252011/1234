# ─── Red ──────────────────────────────────────────────────────────────────────
# Interfaz donde escucha el servidor. 0.0.0.0 = todas las interfaces locales.
# OJO: esto NO te expone a internet. Lo que te expondria seria abrir el puerto
# en el router. NO ABRAS EL PUERTO EN EL ROUTER.
HOST=0.0.0.0
PORT=8099

# ─── Descubrimiento ───────────────────────────────────────────────────────────
# Cada cuanto se re-escanea la red, en segundos.
DISCOVERY_INTERVAL_SECONDS=300
# Cuanto espera el M-SEARCH de SSDP las respuestas de los TVs, en ms.
SSDP_TIMEOUT_MS=4000
# Timeout de cada sondeo de puerto, en ms. Subilo si tu red es lenta.
PROBE_TIMEOUT_MS=1200

# ─── Seguridad ────────────────────────────────────────────────────────────────
# PIN para entrar a la interfaz. Vacio = sin autenticacion.
#
# Dentro de tu casa podes dejarlo vacio.
#
# OBLIGATORIO si vas a usar la aplicacion desde fuera de casa. Sin PIN,
# cualquiera que de con la direccion controla tus televisores Y puede navegar
# y descargar los videos de MEDIA_DIRS.
#
# Usa 6 digitos o mas. Tras 5 intentos fallidos se bloquea por 5 minutos.
AUTH_PIN=
# Origen al que se le permite llamar a esta API desde otro sitio.
#
# Sirve para usar el control remoto publicado como artefacto de Claude. Sin
# esto, el navegador bloquea las llamadas de esa pagina por politica de mismo
# origen.
#
# Si lo completas, AUTH_PIN deja de ser opcional: el servidor se niega a
# arrancar sin PIN, porque permitir llamadas desde afuera sin contrasena
# dejaria tus televisores y tus videos al alcance de cualquiera.
#
# REMOTE_ORIGINS=https://claude.ai
REMOTE_ORIGINS=

# Clave para cifrar los tokens de emparejamiento de los TVs en la base.
# Si la dejas vacia se genera sola en el primer arranque y se guarda en data/.
# NUNCA subas esta clave a un repositorio.
ENCRYPTION_KEY=

# ─── Logs ─────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
# Poner en 'debug' para ver el trafico crudo de los protocolos.
LOG_LEVEL=info
