# ─── Red ──────────────────────────────────────────────────────────────────────
# Interfaz donde escucha el servidor. 0.0.0.0 = todas las interfaces locales.
# OJO: esto NO te expone a internet. Lo que te expondria seria abrir el puerto
# en el router. NO ABRAS EL PUERTO EN EL ROUTER.
HOST=0.0.0.0
PORT=8099

# ─── Descubrimiento ───────────────────────────────────────────────────────────
# Cada cuanto se re-escanea la red, en segundos.
DISCOVERY_INTERVAL_SECONDS=300
# Cuanto espera el M-SEARCH de SSDP las respuestas de los TVs, en ms.
SSDP_TIMEOUT_MS=4000
# Timeout de cada sondeo de puerto, en ms. Subilo si tu red es lenta.
PROBE_TIMEOUT_MS=1200

# ─── Seguridad ────────────────────────────────────────────────────────────────
# PIN opcional para entrar a la interfaz. Vacio = sin autenticacion.
AUTH_PIN=
# Clave para cifrar los tokens de emparejamiento de los TVs en la base.
# Si la dejas vacia se genera sola en el primer arranque y se guarda en data/.
# NUNCA subas esta clave a un repositorio.
ENCRYPTION_KEY=

# ─── Logs ─────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
# Poner en 'debug' para ver el trafico crudo de los protocolos.
LOG_LEVEL=info
