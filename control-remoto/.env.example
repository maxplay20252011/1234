# Copiá este archivo a .env y completá. NUNCA subas el .env real.
# Generar un token:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN=

# Solo para el agente: URL pública del servidor (siempre wss:// fuera de localhost)
SERVER_URL=ws://localhost:8080

# Solo para el servidor
PORT=8080
# Poné 1 si el servidor corre detrás de un proxy (Render, Railway, Fly): usa la IP real para el límite de intentos
TRUST_PROXY=0
